---
import { JOB_BOT_DOODS } from "../job-bots";
import { LandingBotAvatar } from "./LandingBotAvatar";

interface Props {
  name: string;
}

const { name } = Astro.props;
const dood = JOB_BOT_DOODS[name];

if (!dood) {
  throw new Error(`Missing landing dood for roster bot: ${name}`);
}
---

<span class="roster-bot-avatar" role="img" aria-label={name}>
  <LandingBotAvatar color={dood.color} identity={dood.slug} size={56} client:visible />
</span>

<style>
  .roster-bot-avatar {
    display: grid;
    width: 88px;
    height: 88px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 18px;
    background: #fff;
  }
</style>
