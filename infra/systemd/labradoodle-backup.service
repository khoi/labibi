[Unit]
Description=Create and verify a Labradoodle production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/labradoodle/backup.env
ExecStart=/usr/local/sbin/labradoodle-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
