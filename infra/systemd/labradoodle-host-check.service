[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/labradoodle/backup.env
ExecStart=/usr/local/sbin/labradoodle-host-check
StateDirectory=labradoodle/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/labradoodle/alerts
ProtectHome=true
PrivateTmp=true
